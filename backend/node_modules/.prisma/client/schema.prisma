generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String     @id @default(uuid())
  email     String     @unique
  password  String
  name      String?
  tasks     Task[]     @relation("UserTasks")
  auditLogs AuditLog[] // Relation to track user actions

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Task {
  id          String     @id @default(uuid()) // UUID is perfect for offline creation
  title       String
  description String?
  status      TaskStatus @default(PENDING) // Use Enum for strict typing
  dueDate     DateTime?

  // Relations
  createdBy String
  user      User   @relation("UserTasks", fields: [createdBy], references: [id])

  // Sync & Audit Fields
  isDeleted    Boolean   @default(false) // Soft delete (crucial for sync)
  version      Int       @default(1) // Version control for conflict resolution
  lastSyncedAt DateTime? // Track when it last touched the server

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt // Used to compare with local device time
}

model AuditLog {
  id       String @id @default(uuid())
  action   String // "CREATE", "UPDATE", "DELETE", "SYNC"
  entity   String // "Task"
  entityId String // ID of the task modified
  details  Json? // Store what changed (e.g., { oldStatus: 'pending', newStatus: 'completed' })

  userId String
  user   User   @relation(fields: [userId], references: [id])

  timestamp DateTime @default(now())
}

// Enums make your code safer than using raw strings
enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}
